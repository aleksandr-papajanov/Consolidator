<Project Sdk="Microsoft.NET.Sdk;Microsoft.NET.Sdk.Publish">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JClement.NLoptNet" Version="2.10.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Consolidator.Managed.Tests" />
  </ItemGroup>

  <Target Name="BuildVst3AfterPublish" AfterTargets="Publish"
          Condition="'$(PublishProfile)' == 'Vst3Plugin' and '$(SkipVst3Build)' != 'true'">
    <PropertyGroup>
      <Vst3ManagedRuntimeDir>$(MSBuildProjectDirectory)\..\Consolidator.Vst3\build\managed-runtime\</Vst3ManagedRuntimeDir>
      <NativeAotPublishOutputDir>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)PubTmp\Out\</NativeAotPublishOutputDir>
    </PropertyGroup>
    <MakeDir Directories="$(Vst3ManagedRuntimeDir)" />
    <Copy
      SourceFiles="$(NativeAotPublishOutputDir)Consolidator.Managed.dll;$(NativeAotPublishOutputDir)nlopt.dll"
      DestinationFolder="$(Vst3ManagedRuntimeDir)"
      SkipUnchangedFiles="true" />
    <MSBuild
      Projects="$(MSBuildProjectDirectory)\..\Consolidator.Vst3\Consolidator.Vst3.vcxproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);Platform=x64" />
  </Target>
</Project>

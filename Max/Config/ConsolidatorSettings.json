{
  "audio": {
    "defaultSampleRateHz": 48000
  },
  "analysis": {
    "fftSize": 4096,
    "maximumFftSize": 8192,
    "curvePointCount": 128,
    "smoothing": 0.4,
    "lowFrequencySmoothing": 1.0,
    "maximumCurveSmoothing": 0.9997,
    "lowFrequencySmoothingExponent": 2.5,
    "highFrequencyTiltExponent": 1.35,
    "hannWindowCoefficient": 0.5,

{
  "name": "example-emulation",
  "reference": {
    "plugin": "ReferencePlugin.vst3",
    "state": "reference.state"
  },
  "candidate": {
    "plugin": "CandidatePlugin.vst3",
    "state": "candidate.state",
    "model": "vst3-parameters",
    "parameters": [
      {
        "id": "tone.shape",
        "pluginParameter": "Model Shape",
        "lower": 0.0,
        "upper": 1.0,
        "initial": 0.5
      }
    ]
  },
  "sampleRates": [44100, 96000],
  "blockSize": 128,
  "seed": 5489,
  "conditions": [
    {
      "id": "minimum",
      "reference": { "parameters": { "Amount": 0.0 } },
      "candidate": { "parameters": { "Amount": 0.0 } }
    },
    {
      "id": "maximum",
      "reference": { "parameters": { "Amount": 1.0 } },
      "candidate": { "parameters": { "Amount": 1.0 } }
    }
  ],
  "probes": [
    "linear-sweep",
    "harmonic-grid",
    "level-sweep",
    "transient-burst",
    "multitone",
    "stereo-interaction"
  ],
  "probeSettings": {
    "linear-sweep": {
      "minimumFrequency": 20,
      "maximumFrequency": 20000,
      "pointsPerOctave": 12,
      "minimumLevelDb": -30,
      "maximumLevelDb": -30,
      "maximumHarmonic": 1
    },
    "harmonic-grid": {
      "minimumFrequency": 20,
      "maximumFrequency": 20000,
      "pointsPerOctave": 12,
      "minimumLevelDb": -30,
      "maximumLevelDb": 10,
      "levelStepDb": 1,
      "maximumHarmonic": 16,
      "harmonicFloorDbc": -180
    },
    "level-sweep": {
      "frequency": 100,
      "levelsDb": [-36, -30, -24, -18, -12, -6, 0, 6],
      "secondsPerLevel": 0.5,
      "maximumHarmonic": 8
    },
    "transient-burst": {
      "frequencies": [60, 200, 1000, 5000],
      "levelsDb": [-18, -6, 0],
      "silenceSeconds": 0.25,
      "sustainSeconds": 0.5,
      "tailSeconds": 0.5
    },
    "multitone": {
      "frequencies": [997, 1201, 1511],
      "levelDb": -18,
      "samples": 65536
    },
    "stereo-interaction": {
      "frequency": 1000,
      "levelDb": -12,
      "seconds": 0.5
    }
  },
  "splits": {
    "training": "training.json",
    "validation": "validation.json",
    "listening": "listening",
    "validationFraction": 0.2
  },
  "objective": {
    "gainDb": 1.0,
    "phase": 0.05,
    "rms": 0.35,
    "harmonics": 1.0,
    "thd": 0.35,
    "peak": 0.5,
    "envelope": 1.0,
    "intermodulation": 0.4,
    "stereo": 0.25
  },
  "optimization": {
    "globalEvaluations": 1000,
    "localEvaluations": 250,
    "population": 0,
    "beamWidth": 8
  },
  "stages": [
    {
      "name": "linear",
      "parameters": ["tone.*"],
      "probes": ["linear-sweep"],
      "maximumObservations": 64
    },
    {
      "name": "joint-refinement",
      "parameters": ["*"],
      "probes": ["*"],
      "maximumObservations": 256
    }
  ]
}

# Visual Studio and user-specific state
**/.vs/
*.user
*.suo
*.VC.db
*.VC.VC.opendb
*.userosscache
*.sln.docstates

# Managed, test, Native and CMake build output
**/bin/
**/obj/
**/build/
**/out/
**/x64/
**/Debug/
**/Release/

# Native generated artifacts
/Consolidator.Native/Consolid.*
/Consolidator.Native/externals/

# Transitional Max project
/Consolidator.Max/

# Local SDK and model-plugin projects
/MinApi/
/ModelPlugins.Vst3/

# Archived legacy code
/Legacy/

# Test and coverage output
**/TestResults/
*.trx
*.coverage
*.coveragexml

# Local DSP measurements, reports and diagnostics
/Measurements/
/diagnostics/
/results/
*.log
*.tmp
*.bak

# Audio inputs and rendered output are local research data
*.wav
*.aif
*.aiff
*.flac
*.mp3
*.ogg
/EmulationLab/RawAudio/**
!/EmulationLab/RawAudio/README.md

# Experiment output is ignored by default; keep manifests and source files
/EmulationLab/Experiments/**
!/EmulationLab/Experiments/**/
!/EmulationLab/Experiments/**/manifest.json
!/EmulationLab/Experiments/**/README.md
!/EmulationLab/Experiments/**/*.cpp
!/EmulationLab/Experiments/**/*.h
!/EmulationLab/Experiments/**/*.hpp
!/EmulationLab/Experiments/**/*.cs
!/EmulationLab/Experiments/**/*.js
!/EmulationLab/Experiments/**/*.py
!/EmulationLab/Experiments/**/*.ps1
!/EmulationLab/Experiments/**/*.cmake
!/EmulationLab/Experiments/**/CMakeLists.txt

# Keep generated sources excluded even inside experiment directories
**/build/
**/bin/
**/obj/
**/__pycache__/
*.pyc

# Compiled plugin bundles and offline datasets
*.vst3
!/Consolidator.Vst3/
*.clap
*.eldataset

# Local operating-system files
.DS_Store
Thumbs.db
